{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**/*" },
        { "path": "/**" },
        { "path": "A:/**/*" },
        { "path": "B:/**/*" },
        { "path": "C:/**/*" },
        { "path": "D:/**/*" },
        { "path": "E:/**/*" },
        { "path": "F:/**/*" },
        { "path": "G:/**/*" },
        { "path": "H:/**/*" },
        { "path": "I:/**/*" },
        { "path": "J:/**/*" },
        { "path": "K:/**/*" },
        { "path": "L:/**/*" },
        { "path": "M:/**/*" },
        { "path": "N:/**/*" },
        { "path": "O:/**/*" },
        { "path": "P:/**/*" },
        { "path": "Q:/**/*" },
        { "path": "R:/**/*" },
        { "path": "S:/**/*" },
        { "path": "T:/**/*" },
        { "path": "U:/**/*" },
        { "path": "V:/**/*" },
        { "path": "W:/**/*" },
        { "path": "X:/**/*" },
        { "path": "Y:/**/*" },
        { "path": "Z:/**/*" },
        { "path": "\\\\*\\**" }
      ]
    }
  ]
}
